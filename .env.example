# Supabase
# Public (client-safe) — the publishable key maps to the `anon` role and is safe
# to expose in the browser. RLS restricts it to public SELECTs.
NEXT_PUBLIC_SUPABASE_URL=your_project_url_here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# Server-only secret key maps to the `service_role` (bypasses RLS).
# NEVER ship to the browser, never commit the real value. Use .env.local only.
SUPABASE_SECRET_KEY=your_secret_key_here

FOOTBALL_DATA_API_KEY=your_api_key_here
