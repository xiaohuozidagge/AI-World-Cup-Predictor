# Template for the local-only CLI sync environment.
#
# Copy this file to `.env.sync` and fill in real values. `.env.sync` is
# gitignored and is NOT auto-loaded by Next.js or OpenNext — it is only read
# by the CLI sync scripts (sync:football, verify:league, check:standings,
# sync:data) via scripts/load-sync-env.ts.
#
# NEXT_PUBLIC_SUPABASE_URL is public config duplicated here so the admin client
# used by the CLI has a URL; the two values below are SECRETS and must never be
# NEXT_PUBLIC-prefixed or committed.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=
FOOTBALL_DATA_API_KEY=
